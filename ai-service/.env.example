# Cấu hình cho AI Service
# 1. Google Gemini API Key (Miễn phí & Mạnh mẽ)
# Lấy key tại: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# 2. OpenAI API Key (Tùy chọn)
# OPENAI_API_KEY=sk-...

# 2b. Cohere API Key (Fallback khi Gemini hết request - Miễn phí)
# Lấy key tại: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# 3. Cấu hình Neo4j (Graph Database)
# Nếu chạy local bằng Docker hoặc cài máy: bolt://localhost:7687
# Nếu dùng Neo4j Aura (Cloud): neo4j+s://<your-db-id>.databases.neo4j.io
NEO4J_URI=neo4j+s://your_instance_id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# 4. Cấu hình Email (SMTP Gmail)
# Tạo App Password tại: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SENDER_EMAIL=your_email@gmail.com

# 5. Cấu hình Turso (External SQLite / libSQL Cloud)
# Tạo db tại: https://turso.tech/
TURSO_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 6. Secret Key cho JWT (Sinh ngẫu nhiên bằng lệnh: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=generate_a_strong_random_secret_key_here

# 7. Chế độ DB khi chạy localhost (0 = cho phép fallback về local SQLite khi Turso lỗi, 1 = bắt buộc dùng Turso)
ONLINE_DB_ONLY=0
