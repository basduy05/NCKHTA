{
  "name": "iedu-intro-video",
  "version": "1.0.0",
  "description": "iEdu platform intro – made with Remotion",
  "scripts": {
    "dev":    "remotion studio",
    "render": "remotion render IEduIntro --output out/iedu_intro.mp4 --log verbose",
    "still":  "remotion still IEduIntro --frame 0 --output out/preview.png"
  },
  "dependencies": {
    "remotion":      "^4.0.0",
    "@remotion/cli": "^4.0.0"
  },
  "devDependencies": {
    "react":          "^18.3.1",
    "react-dom":      "^18.3.1",
    "@types/react":   "^18.3.0",
    "@types/react-dom":"^18.3.0",
    "typescript":     "^5.4.5"
  },
  "remotion": {
    "entryPoint": "src/index.ts"
  }
}
